{
  "uid": "auction-bot",
  "title": "Auction alert bot",
  "tags": [
    "auction-bot",
    "yahoo",
    "discord"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "1m",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "Yahoo/Mercari/Surugaya auction alert Discord bot (job auction-bot). Metrics: docs/monitoring.md.",
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus}"
        },
        "multi": true,
        "includeAll": true,
        "query": {
          "query": "label_values(up{job=\"auction-bot\"}, instance)",
          "refId": "instance"
        },
        "definition": "label_values(up{job=\"auction-bot\"}, instance)",
        "refresh": 2,
        "current": {},
        "sort": 1
      },
      {
        "name": "container",
        "label": "Log container",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${loki}"
        },
        "multi": true,
        "includeAll": true,
        "query": {
          "type": 1,
          "label": "container",
          "stream": "",
          "refId": "container"
        },
        "regex": "/^yahoo-auction-alert-discord-bot.*/",
        "refresh": 2,
        "current": {},
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Health",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Scrape",
      "description": "Prometheus can reach /metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "up{job=\"auction-bot\", instance=~\"$instance\"}",
          "legendFormat": "{{instance}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
