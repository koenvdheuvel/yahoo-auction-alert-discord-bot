        "uid": "${prometheus}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (instance, source, outcome) (increase(auction_bot_checks_total{job=\"auction-bot\", instance=~\"$instance\"}[$__rate_interval]))",
