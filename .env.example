BOT_TOKEN=
DATABASE_URL=alerts.db
CHECK_INTERVAL=1800
CHECK_CONCURRENCY=4
CHECK_TIMEOUT=600
ENABLE_YAHOO_AUCTION=true
ENABLE_MERCARI=true
ENABLE_SURUGAYA=true
REQUEST_TIMEOUT=30
REQUEST_RETRIES=2
MAX_SEARCH_PAGES=100
PRICE_CHANGE_THRESHOLD=500
DELIVERY_MAX_ATTEMPTS=8
LOG_LEVEL=INFO
MONITORING_ENABLED=true
MONITORING_HOST=127.0.0.1
MONITORING_PORT=9100
METRICS_STATS_INTERVAL=10
# Default readiness threshold: CHECK_INTERVAL + CHECK_TIMEOUT + 60 seconds.
# HEALTH_MAX_POLL_AGE=2460

# The dashboard, a web UI separate from monitoring.
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=9101
# Discord sign-in. Set both to turn it on; the access key below is then turned off.
# The address people open the dashboard at, without a path. Register
# <DASHBOARD_PUBLIC_URL>/auth/discord/callback as a redirect in the Discord Developer Portal.
# DASHBOARD_PUBLIC_URL=https://dashboard.example.com
# The OAuth2 client secret of the bot's application, or a file that contains it.
# DASHBOARD_DISCORD_CLIENT_SECRET=
# DASHBOARD_DISCORD_CLIENT_SECRET_FILE=/path/to/private/client-secret
# Without Discord sign-in: an optional access key, at least 16 characters. If empty a
# private file is generated next to DATABASE_URL: alerts.db.dashboard-token.
DASHBOARD_TOKEN=
# DASHBOARD_TOKEN_FILE=/path/to/private/dashboard.key
# Reverse proxies whose X-Forwarded-For and X-Forwarded-Proto count, as comma-separated
# addresses or CIDR ranges, for example the proxies' Docker network. Empty trusts nobody.
# DASHBOARD_TRUSTED_PROXIES=172.18.0.0/16
DASHBOARD_REPLAY_LIMIT=500
HISTORY_RETENTION_DAYS=90
HISTORY_MAX_ROWS=50000
