BOT_TOKEN=
DATABASE_URL=alerts.db
CHECK_INTERVAL=1800
CHECK_CONCURRENCY=4
CHECK_TIMEOUT=600
ENABLE_YAHOO_AUCTION=true
ENABLE_MERCARI=true
ENABLE_SURUGAYA=true
REQUEST_TIMEOUT=30
REQUEST_RETRIES=2
MAX_SEARCH_PAGES=100
PRICE_CHANGE_THRESHOLD=500
DELIVERY_MAX_ATTEMPTS=8
LOG_LEVEL=INFO
MONITORING_ENABLED=true
MONITORING_HOST=127.0.0.1
MONITORING_PORT=9100
METRICS_STATS_INTERVAL=10
# Default readiness threshold: CHECK_INTERVAL + CHECK_TIMEOUT + 60 seconds.
# HEALTH_MAX_POLL_AGE=2460

# Filter Lab operator UI (separate from monitoring).
REVIEW_ENABLED=true
REVIEW_HOST=127.0.0.1
REVIEW_PORT=9101
# Optional access key, at least 16 characters. If empty a private file is generated
# next to DATABASE_URL: alerts.db.review-token (read it to sign into the UI).
REVIEW_TOKEN=
# REVIEW_TOKEN_FILE=/path/to/private/filter-lab.key
REVIEW_REPLAY_LIMIT=500
HISTORY_RETENTION_DAYS=90
HISTORY_MAX_ROWS=50000
